## .NET / Visual Studio gitignore (canonical subset)

# Python bytecode (the family-lint gate and its tests run under CI)
__pycache__/
*.py[cod]


# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/

# Visual Studio temp / cache
.vs/
.vscode/
*.user
*.suo
*.userprefs
*.sln.docstates
*.userosscache

# NuGet
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets

# Local pack output
artifacts/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
TestResults/

# reportgenerator merged output (local-only; CI emits its own report)
coverage-report/
.coverage-report/
coverage-merged/

# README sample project, generated by assertions-ci's readme_samples.py (tests/ReadmeSamples.Prelude.cs is tracked)
tests/.readme-samples/

# Tooling
.idea/
*.swp
*.swo
.DS_Store

# Stryker
StrykerOutput/

# Snapshot test transient output (never commit; the .expected.txt baseline is what's tracked)
*.actual.txt
*.received.*

# Rider
.idea/
*.sln.iml
