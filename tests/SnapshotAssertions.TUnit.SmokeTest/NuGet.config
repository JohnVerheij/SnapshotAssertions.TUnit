<?xml version="1.0" encoding="utf-8"?>
<!--
  Local-feed configuration for the external-consumer smoke-test project. Adds the pack output
  directory (artifacts at the repository root) as a NuGet source ahead of nuget.org, so the smoke
  test consumes the packages just built from this repository rather than a published version. The
  local feed is empty until a pack writes to it; CI packs into it before the smoke test.

  To run the smoke test locally, pack with a new version that no release has, every time, and give
  the smoke test that version. From the repository root:

    VERSION=99.0.0-local.$(date +%Y%m%d%H%M%S)
    dotnet pack -c Release -o artifacts -p:Version=$VERSION
    cd tests/SnapshotAssertions.TUnit.SmokeTest
    dotnet run -c Release -f <target framework> -p:SmokePackageVersion=$VERSION

  NuGet keeps a package in the global packages folder by name and version, so a second pack under
  the same version is restored from there: the earlier build. Never pack under a released version:
  the local build then stays in the global packages folder under that version, every other
  repository on the machine restores it instead of the package on nuget.org, and its locked restore
  fails with NU1403.

  The packageSourceMapping block is required because the root nuget.config maps every package to
  nuget.org. It routes the packages of this repository to the local feed and everything else to
  nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-pack" value="../../artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="local-pack">
      <package pattern="SnapshotAssertions" />
      <package pattern="SnapshotAssertions.TUnit" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
