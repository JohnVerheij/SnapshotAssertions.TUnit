<!--
  Direct-reference entry point. NuGet imports build/<PackageId>.targets for a direct reference and
  buildTransitive/<PackageId>.targets for every reference (direct and transitive). The real content
  lives in buildTransitive/, so this file only forwards to it; a direct reference therefore evaluates
  that file once.
-->
<Project>

  <Import Project="$(MSBuildThisFileDirectory)../buildTransitive/SnapshotAssertions.TUnit.targets" />

</Project>
