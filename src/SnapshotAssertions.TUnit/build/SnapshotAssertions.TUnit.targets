<!--
  Fallback entry point. With PackageReference, NuGet imports buildTransitive/<PackageId>.targets for
  direct and transitive references alike when the package has one, and does not import this file.
  Clients that only know build/ import this file instead, which forwards to the same content, so the
  targets are evaluated once either way.
-->
<Project>

  <Import Project="$(MSBuildThisFileDirectory)../buildTransitive/SnapshotAssertions.TUnit.targets" />

</Project>
