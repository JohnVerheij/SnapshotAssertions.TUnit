<!--
  Auto-imported by NuGet when a project references SnapshotAssertions.TUnit, directly or through
  another project or package. The package ships this file under buildTransitive/, and a small
  build/SnapshotAssertions.TUnit.targets imports it, so a direct reference evaluates it once.
  NuGet includes the file in the consuming csproj's MSBuild evaluation. Result: consumers don't
  write any csproj wiring; .expected.txt files committed
  under their project's Snapshots/ folder are automatically copied to the test binary's
  output directory at build time.

  Opt out: set <SnapshotAssertionsAutoIncludeSnapshots>false</SnapshotAssertionsAutoIncludeSnapshots>
  in your csproj to disable the auto-include and wire the <None Include> manually if you
  need a non-default snapshot folder layout.

  Independent of that opt-out, the file records the project directory as the runtime option
  SnapshotAssertions.ProjectDirectory (in the consumer's runtimeconfig.json). Accept mode reads
  it to write baselines into the project's Snapshots/ folder even when the build output is
  outside the project (UseArtifactsOutput, dotnet test -o).
-->
<Project>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="SnapshotAssertions.ProjectDirectory"
                                    Value="$(MSBuildProjectDirectory)" />
  </ItemGroup>

  <ItemGroup Condition="'$(SnapshotAssertionsAutoIncludeSnapshots)' != 'false'">
    <None Include="Snapshots\**\*.expected.txt"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
